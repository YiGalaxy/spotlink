# application-local.yml 的模板。复制它，填上你自己的值。
#
#   cp application-local.yml.example application-local.yml
#
# 真正的那个文件已被 gitignore，所以密钥不会进仓库。
#
# 整个文件不建也行：应用会退回 application.yml 里的默认值。模型服务由后端调用，
# 前端不需要也不应该保存密钥。

bulk:
  advisor:
    enabled: ${SPOTLINK_ADVISOR_ENABLED:true}

# OpenAI-compatible 配置由顾问客户端读取；推荐直接写入项目根目录 .env。
# 本地 Ollama（Docker 后端访问宿主机）：
# SPOTLINK_ADVISOR_API_KEY=ollama
# SPOTLINK_ADVISOR_BASE_URL=http://host.docker.internal:11434/v1
# SPOTLINK_ADVISOR_MODEL=qwen3:4b
