COMPOSE_PROJECT_NAME=spotlink-next
MYSQL_DATABASE=spotlink
MYSQL_USER=spotlink
MYSQL_PASSWORD=GENERATE_ON_FIRST_START
MYSQL_ROOT_PASSWORD=GENERATE_ON_FIRST_START
REDIS_PASSWORD=GENERATE_ON_FIRST_START
BACKEND_PORT=18081
FRONTEND_PORT=18080
SPRING_PROFILES_ACTIVE=local
SPOTLINK_JWT_SECRET=GENERATE_BASE64_ON_FIRST_START
# AI 顾问由后端调用 OpenAI-compatible 服务，浏览器不会接触这个密钥。
# 留空密钥时顾问不调用模型；本地无鉴权服务填 ollama 或 local 即可。
# 本地容器模型运行 setup-local-model.cmd；已有宿主服务用 http://host.docker.internal:11434/v1。
# 云端例：https://api.openai.com/v1 + gpt-4o-mini，或 https://api.deepseek.com/v1 + deepseek-flash。
SPOTLINK_ADVISOR_ENABLED=true
SPOTLINK_ADVISOR_API_KEY=
SPOTLINK_ADVISOR_BASE_URL=http://ollama:11434/v1
SPOTLINK_ADVISOR_MODEL=qwen3:4b
SPOTLINK_ADVISOR_MAX_TOKENS=4096
SPOTLINK_ADVISOR_TIMEOUT_SECONDS=120
# 普通模型用 max_tokens；要求新版参数的模型改成 max_completion_tokens。
SPOTLINK_ADVISOR_TOKEN_PARAMETER=max_tokens
# 后台 API Key 加密专用密钥，由首次启动自动生成；不要手工改掉或丢失。
SPOTLINK_ADVISOR_CONFIG_SECRET=GENERATE_BASE64_ON_FIRST_START
# 有 NVIDIA GPU 且 Docker 支持 GPU 时设为 true；默认 CPU，云端调用不受影响。
SPOTLINK_LOCAL_AI_GPU=false
# 向量服务独立于聊天模型；下载 bge-m3 并建立索引后再启用。
SPOTLINK_EMBEDDING_ENABLED=false
SPOTLINK_EMBEDDING_URL=http://ollama:11434
SPOTLINK_EMBEDDING_MODEL=bge-m3
SPOTLINK_EMBEDDING_DIMENSIONS=1024
SPOTLINK_EMBEDDING_API_KEY=ollama
# 同名模型替换权重时更新版本，旧向量会自动排除并等待重建。
SPOTLINK_EMBEDDING_REVISION=1
SPOTLINK_EMBEDDING_TIMEOUT_SECONDS=45
