{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpotLink 受控插入记录",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["scenarioId", "table", "values"],
    "properties": {
      "scenarioId": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
      "table": { "enum": ["t_enterprise", "t_warehouse", "t_commodity_category", "t_inventory_note"] },
      "values": { "type": "object", "required": ["id", "created_at", "updated_at"], "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{1,19}$" },
        "created_at": { "type": "string" }, "updated_at": { "type": "string" }
      } }
    }
  }
}
